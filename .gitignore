# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary, built with `go test -c`
*.test

# Stray build artifacts at the repo root (bin/ is the real target)
/engine

# Coverage profiles
*.out
coverage.*
!coverage.go
*.coverprofile

# Dependency directories
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

# Web app
web/node_modules/
web/dist/

# Embedded dist sync target (regenerated by `make web`) — .gitkeep is
# committed so `//go:embed all:dist` matches on a fresh clone too.
internal/webdist/dist/*
!internal/webdist/dist/.gitkeep
web/tsconfig.tsbuildinfo
